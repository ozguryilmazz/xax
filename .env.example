# paper: sanal bakiye | testnet: Binance Futures Testnet | live: GERÇEK hesap
TRADER_MODE=paper
# binance: gerçek piyasa verisi | simulated: internetsiz demo verisi
TRADER_MARKET_SOURCE=binance

# Sadece testnet/live için. Anahtarda PARA ÇEKME yetkisi KAPALI, IP kısıtlaması AÇIK olmalı.
TRADER_API_KEY=
TRADER_API_SECRET=

TRADER_PAPER_START_BALANCE=1000
TRADER_MAKER_FEE=0.0002
TRADER_TAKER_FEE=0.0005

# SL = teminatın %30 kaybı, TP = teminatın %15 kazancı
TRADER_SL_MARGIN_PCT=0.30
TRADER_TP_MARGIN_PCT=0.15

# Risk limitleri
TRADER_MAX_DAILY_LOSS_USDT=100
TRADER_MAX_OPEN_POSITIONS=5
TRADER_MAX_LEVERAGE=20
TRADER_MAX_MARGIN_PER_ORDER=200

TRADER_TOP_N=200
# Sinyal için hacmin önceki muma göre en az ne kadar düşmesi gerektiği (0 = herhangi bir düşüş)
TRADER_SIGNAL_MIN_VOLUME_DROP=0

# Telegram bildirimleri (opsiyonel)
TRADER_TELEGRAM_BOT_TOKEN=
TRADER_TELEGRAM_CHAT_ID=

TRADER_DB_PATH=data/trader.db
TRADER_HOST=127.0.0.1
TRADER_PORT=8000
